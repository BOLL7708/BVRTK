<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>false</InvariantGlobalization>
        <IsPackable>false</IsPackable>
        <Title>BOLL's VR Toolkit</Title>
        <Description>BOLL's Virtual Reality Toolkit provides a range of additional features that extends SteamVR.</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition="'$(CI)' != ''">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\BVRTKCG\BVRTKCG.csproj" OutputItemType="Analyzer"/>
        <ProjectReference Include="..\EasyOpenVR\EasyOpenVR.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Hexa.NET.GLFW" Version="1.0.5"/>
        <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9"/>
        <PackageReference Include="Hexa.NET.ImGui.Backends" Version="1.0.18"/>
        <PackageReference Include="Hexa.NET.ImGui.Backends.GLFW" Version="1.0.18"/>
        <PackageReference Include="Hexa.NET.ImGui.Widgets" Version="1.2.18"/>
        <PackageReference Include="Hexa.NET.OpenGL3" Version="1.1.0"/>
        <PackageReference Include="Hexa.NET.StbImage" Version="1.0.2"/>
        <PackageReference Include="NLog" Version="6.1.3"/>
        <PackageReference Include="SharpHook" Version="7.1.1"/>
        <PackageReference Include="Steamworks.NET" Version="2024.8.0"/>
        <PackageReference Include="SuperSocket.WebSocket.Server" Version="2.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Components\Overlays\"/>
        <Folder Include="Components\Scripts\"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\Methods.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Methods.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\JsonRpcErrors.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>JsonRpcErrors.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\GuiSidebarPrompts.resx">
          <Generator>ResXFileCodeGenerator</Generator>
          <LastGenOutput>GuiSidebarPrompts.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\HardwareInputPrompts.resx">
          <Generator>ResXFileCodeGenerator</Generator>
          <LastGenOutput>HardwareInputPrompts.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\Methods.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Methods.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\JsonRpcErrors.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>JsonRpcErrors.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\GuiSidebarPrompts.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>GuiSidebarPrompts.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\HardwareInputPrompts.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>HardwareInputPrompts.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\GuiSidebarPrompts.Designer.cs">
          <DesignTime>True</DesignTime>
          <AutoGen>True</AutoGen>
          <DependentUpon>GuiSidebarPrompts.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\HardwareInputPrompts.Designer.cs">
          <DesignTime>True</DesignTime>
          <AutoGen>True</AutoGen>
          <DependentUpon>HardwareInputPrompts.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\Media\bvrtk.thumbnail.png"/>
        <EmbeddedResource Include="Resources\Media\bvrtk.logo.png"/>
        <None Include="Resources\Fonts\AtkinsonHyperlegible-Bold.ttf">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="Resources\Fonts\AtkinsonHyperlegible-BoldItalic.ttf">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="Resources\Fonts\AtkinsonHyperlegible-Italic.ttf">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="Resources\Fonts\AtkinsonHyperlegible-Regular.ttf">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Build\version.txt">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    
    <Target Name="GenerateVersionFile" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
        <Exec Command="bash ./Build/version.sh" ContinueOnError="false" />
    </Target>

</Project>
